<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFC107"
    android:padding="16dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingBottom="40dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:text="Ajustes Laboratorio"
            android:textSize="26sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp" />

        <!-- Inputs -->
        <EditText
            android:id="@+id/etCodigo"
            android:hint="Código"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="16dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etNombre"
            android:hint="Nombre"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="16dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etPiso"
            android:hint="Piso"
            android:inputType="number"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="16dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etPabellon"
            android:hint="Pabellón"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="16dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etImgSalon"
            android:hint="Imagen salón (ej: salon_lcom9.jpg)"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="16dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etImgRecorrido"
            android:hint="Imagen recorrido (ej: croquis_lcom9.png)"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="16dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/etDescripcion"
            android:hint="Descripción"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:background="@drawable/custom_input"
            android:layout_marginBottom="24dp"
            android:padding="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Botón Agregar -->
        <Button
            android:id="@+id/btnGuardar"
            android:text="Agregar"
            android:textAllCaps="false"
            android:backgroundTint="@color/black"
            android:textColor="#FFFFFF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="16dp" />

        <!-- Botones Editar y Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnEditar"
                android:text="Editar"
                android:textAllCaps="false"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:padding="16dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnEliminar"
                android:text="Eliminar"
                android:textAllCaps="false"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:padding="16dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
